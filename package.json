{
  "name": "laura-canvas",
  "private": true,
  "type": "module",
  "description": "An open, typed JSON scene format with a canvas editor, layout engine, browser and headless renderers, QA and LLM tools for editable graphic design.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:clean": "node scripts/check-clean.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:clean && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
